{
  "code-runner.executorMapByFileExtension": {
    ".td": "cmake --build ${workspaceRoot}/build --target StackIRIncGen --parallel 2>&1"
  },
  "code-runner.fileDirectoryAsTempDir": false,
  "code-runner.runInTerminal": true,
  "code-runner.clearPreviousOutput": true,
  "files.associations": {
    "*.td": "tablegen"
  }
}
